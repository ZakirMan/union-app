rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Вспомогательная функция проверки размера (maxSizeMB * 1MB)
    function isFileSizeValid(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }

    // Чтение разрешено всем авторизованным
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // ЗАЯВКИ
    match /requests/{fileName} {
      allow create: if request.auth != null 
                    && (fileName.matches(request.auth.uid + '_.*') || fileName.matches('manual_.*'))
                    && isFileSizeValid(10);
      allow update, delete: if false; // Запрещаем изменение и удаление истории
    }

    // АВАТАРЫ
    match /avatars/{fileName} {
      allow write: if request.auth != null 
                   && fileName.matches(request.auth.uid + '_.*') 
                   && request.resource.contentType.matches('image/.*') 
                   && isFileSizeValid(2);
    }

    // ДЕЛЕГИРОВАНИЕ
    match /delegations/{fileName} {
      allow create: if request.auth != null 
                   && fileName.matches(request.auth.uid + '_.*') 
                   && isFileSizeValid(5);
      allow update, delete: if false;
    }

    // РЕГИСТРАЦИОННЫЕ ДОКУМЕНТЫ
    match /registration_statements/{fileName} {
      allow create: if request.auth != null 
                   && fileName.matches(request.auth.uid + '_.*') 
                   && isFileSizeValid(5);
      allow update, delete: if false;
    }

    match /deductions/{fileName} {
      allow create: if request.auth != null 
                   && fileName.matches(request.auth.uid + '_.*') 
                   && isFileSizeValid(5);
      allow update, delete: if false;
    }

    match /id_cards/{fileName} {
      allow create: if request.auth != null 
                   && fileName.matches(request.auth.uid + '_.*') 
                   && isFileSizeValid(5);
      allow update, delete: if false;
    }

    // ОСТАЛЬНЫЕ ПАПКИ (news, templates, union_documents, links и т.д.)
    // Создавать файлы в этих папках смогут все (так как Storage Rules не видят Firestore Role),
    // но удалять и перезаписывать (с учетом Date.now() в имени файла) не смогут.
    match /{folder}/{fileName} {
      allow create: if request.auth != null 
                    && isFileSizeValid(20);
      allow update, delete: if false;
    }
  }
}
