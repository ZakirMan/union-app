rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Функция проверки администратора
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // По умолчанию запрещаем всё, кроме админов
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Пользователи (Чтение для всех авторизованных, запись только своих данных)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Публичные коллекции (только чтение для авторизованных)
    match /news/{docId} { allow read: if request.auth != null; }
    match /team/{docId} { allow read: if request.auth != null; }
    match /links/{docId} { allow read: if request.auth != null; }
    match /templates/{docId} { allow read: if request.auth != null; }
    match /union_documents/{docId} { allow read: if request.auth != null; }
    match /conferences/{docId} { allow read: if request.auth != null; }

    // Опросы и Тесты (Чтение и обновление для голосования/прохождения)
    match /polls/{docId} { 
      allow read: if request.auth != null;
      allow update: if request.auth != null; 
    }
    match /tests/{docId} { 
      allow read: if request.auth != null;
      allow update: if request.auth != null; 
    }

    // Обращения к админу (Только свои)
    match /requests/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Заявки на делегирование
    match /delegation_requests/{docId} {
      allow read, write: if request.auth != null; 
    }
  }
}
